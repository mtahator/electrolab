{
  "command": "document.region",
  "input": {
    "$defs": {
      "BlobRef": {
        "description": "A file in the content-addressed store: messages carry these, never large bytes (§9.4).",
        "properties": {
          "hash": {
            "$ref": "#/$defs/Hash",
            "description": "Content hash."
          },
          "media_type": {
            "$ref": "#/$defs/MediaType",
            "description": "What the bytes are."
          },
          "size": {
            "description": "Size in bytes.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "size",
          "media_type"
        ],
        "type": "object"
      },
      "Hash": {
        "description": "BLAKE3 content hash (hex)",
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "MediaType": {
        "description": "A media type such as `application/pdf`.",
        "type": "string"
      },
      "PageColors": {
        "description": "Page colours (`#rrggbb`) for drawing a page on a dark paper.",
        "properties": {
          "background": {
            "description": "The page.",
            "type": "string"
          },
          "foreground": {
            "description": "Text and lines.",
            "type": "string"
          }
        },
        "required": [
          "background",
          "foreground"
        ],
        "type": "object"
      },
      "PagePoint": {
        "description": "A point on a page.",
        "properties": {
          "x": {
            "description": "Distance from the left edge.",
            "format": "float",
            "type": "number"
          },
          "y": {
            "description": "Distance from the top edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "PageRect": {
        "description": "A rectangle on one page.",
        "properties": {
          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "x0": {
            "description": "Left edge.",
            "format": "float",
            "type": "number"
          },
          "x1": {
            "description": "Right edge.",
            "format": "float",
            "type": "number"
          },
          "y0": {
            "description": "Top edge.",
            "format": "float",
            "type": "number"
          },
          "y1": {
            "description": "Bottom edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "page",
          "x0",
          "y0",
          "x1",
          "y1"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input of `document.region`: a point (click) or a rectangle (drag) on a page.",
    "properties": {
      "colors": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageColors"
          },
          {
            "type": "null"
          }
        ],
        "description": "Paper colours for a dark paper (as `document.render`)."
      },
      "exact": {
        "default": false,
        "description": "Crop exactly `rect` (a known object's box) instead of snapping a drag to the object it\ncovers best.",
        "type": "boolean"
      },
      "file": {
        "$ref": "#/$defs/BlobRef",
        "description": "The file."
      },
      "page": {
        "description": "1-based page.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "point": {
        "anyOf": [
          {
            "$ref": "#/$defs/PagePoint"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "A clicked point."
      },
      "rect": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageRect"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "A dragged rectangle."
      },
      "width_px": {
        "default": null,
        "description": "Width of the cropped image in pixels (default 800).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "required": [
      "file",
      "page"
    ],
    "title": "RegionRequest",
    "type": "object"
  },
  "output": {
    "$defs": {
      "BlobRef": {
        "description": "A file in the content-addressed store: messages carry these, never large bytes (§9.4).",
        "properties": {
          "hash": {
            "$ref": "#/$defs/Hash",
            "description": "Content hash."
          },
          "media_type": {
            "$ref": "#/$defs/MediaType",
            "description": "What the bytes are."
          },
          "size": {
            "description": "Size in bytes.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "size",
          "media_type"
        ],
        "type": "object"
      },
      "DocObject": {
        "description": "An object on a page.",
        "properties": {
          "caption_rect": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageRect"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The caption's box."
          },
          "id": {
            "description": "Stable within the file: `p<page>-<kind>-<n>`.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/ObjectKind",
            "description": "What it is."
          },
          "label": {
            "default": null,
            "description": "Printed label: \"Figure 3\", \"Table 2\", \"(7)\", \"4.2\".",
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "default": null,
            "description": "The number alone: \"3\", \"2\", \"7\", \"4.2\".",
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "description": "Position in reading order on the page (0 = first).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "rect": {
            "$ref": "#/$defs/PageRect",
            "description": "Where it is."
          },
          "score": {
            "description": "Detector confidence 0–1 (1 when found from the text alone).",
            "format": "float",
            "type": "number"
          },
          "text": {
            "default": null,
            "description": "Figures and tables: the caption text; headings: the heading text.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "rect",
          "score",
          "order"
        ],
        "type": "object"
      },
      "Hash": {
        "description": "BLAKE3 content hash (hex)",
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "MediaType": {
        "description": "A media type such as `application/pdf`.",
        "type": "string"
      },
      "ObjectKind": {
        "description": "What an object on the page is.",
        "oneOf": [
          {
            "const": "figure",
            "description": "A figure, picture or chart.",
            "type": "string"
          },
          {
            "const": "table",
            "description": "A table.",
            "type": "string"
          },
          {
            "const": "equation",
            "description": "A displayed equation.",
            "type": "string"
          },
          {
            "const": "heading",
            "description": "A section heading.",
            "type": "string"
          },
          {
            "const": "title",
            "description": "The paper's title.",
            "type": "string"
          },
          {
            "const": "caption",
            "description": "A figure or table caption.",
            "type": "string"
          },
          {
            "const": "text",
            "description": "A paragraph of body text.",
            "type": "string"
          },
          {
            "const": "list_item",
            "description": "A list item.",
            "type": "string"
          },
          {
            "const": "footnote",
            "description": "A footnote.",
            "type": "string"
          },
          {
            "const": "page_furniture",
            "description": "Running header or footer.",
            "type": "string"
          },
          {
            "const": "code",
            "description": "Program code or an algorithm.",
            "type": "string"
          }
        ]
      },
      "PageRect": {
        "description": "A rectangle on one page.",
        "properties": {
          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "x0": {
            "description": "Left edge.",
            "format": "float",
            "type": "number"
          },
          "x1": {
            "description": "Right edge.",
            "format": "float",
            "type": "number"
          },
          "y0": {
            "description": "Top edge.",
            "format": "float",
            "type": "number"
          },
          "y1": {
            "description": "Bottom edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "page",
          "x0",
          "y0",
          "x1",
          "y1"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Output of `document.region`.",
    "properties": {
      "image": {
        "$ref": "#/$defs/BlobRef",
        "description": "The region as a PNG."
      },
      "object": {
        "anyOf": [
          {
            "$ref": "#/$defs/DocObject"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The object under the point or best covering the rectangle, if any."
      },
      "rect": {
        "$ref": "#/$defs/PageRect",
        "description": "The region (the object's box, or the dragged rectangle)."
      },
      "text": {
        "description": "Text inside the region.",
        "type": "string"
      }
    },
    "required": [
      "rect",
      "image",
      "text"
    ],
    "title": "RegionHit",
    "type": "object"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "read"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "The object at a point or in a rectangle, with an image of it"
}
