{
  "command": "workspace.list_collections",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "null",
    "type": "null"
  },
  "output": {
    "$defs": {
      "Collection": {
        "description": "A named group of papers.",
        "properties": {
          "created_ms": {
            "description": "Created, ms since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "$ref": "#/$defs/CollectionId",
            "description": "Id."
          },
          "name": {
            "description": "Name.",
            "type": "string"
          },
          "papers": {
            "description": "Number of papers in it.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/$defs/CollectionId"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The folder it is in; the top of the library when missing."
          }
        },
        "required": [
          "id",
          "name",
          "papers",
          "created_ms"
        ],
        "type": "object"
      },
      "CollectionId": {
        "description": "A collection of papers.\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "$ref": "#/$defs/Collection"
    },
    "title": "Array_of_Collection",
    "type": "array"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "read"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "Collections, by name"
}
