{
  "command": "workspace.get_reading_state",
  "input": {
    "$defs": {
      "PaperId": {
        "description": "A paper (a PDF in the library or a project).\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input naming one paper.",
    "properties": {
      "paper": {
        "$ref": "#/$defs/PaperId",
        "description": "The paper."
      }
    },
    "required": [
      "paper"
    ],
    "title": "PaperRef",
    "type": "object"
  },
  "output": {
    "$defs": {
      "Bookmark": {
        "description": "A named place in a paper.",
        "properties": {
          "created_ms": {
            "description": "Created, ms since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "$ref": "#/$defs/ObjectId",
            "description": "Id."
          },
          "location": {
            "$ref": "#/$defs/Location",
            "description": "Where."
          },
          "name": {
            "description": "Name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "location",
          "created_ms"
        ],
        "type": "object"
      },
      "Location": {
        "description": "\"Go there\": the single way to point at a place in a paper (links, history, search hits,\ncitations in answers, bookmarks).",
        "properties": {
          "page": {
            "description": "1-based page.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "paper": {
            "$ref": "#/$defs/PaperId",
            "description": "The paper."
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageRect"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Area to show and mark, if any."
          },
          "zoom": {
            "anyOf": [
              {
                "$ref": "#/$defs/ZoomSpec"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Zoom to apply, if any."
          }
        },
        "required": [
          "paper",
          "page"
        ],
        "type": "object"
      },
      "ObjectId": {
        "description": "A research object of any kind.\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      },
      "PageRect": {
        "description": "A rectangle on one page.",
        "properties": {
          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "x0": {
            "description": "Left edge.",
            "format": "float",
            "type": "number"
          },
          "x1": {
            "description": "Right edge.",
            "format": "float",
            "type": "number"
          },
          "y0": {
            "description": "Top edge.",
            "format": "float",
            "type": "number"
          },
          "y1": {
            "description": "Bottom edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "page",
          "x0",
          "y0",
          "x1",
          "y1"
        ],
        "type": "object"
      },
      "PaperId": {
        "description": "A paper (a PDF in the library or a project).\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      },
      "ViewMode": {
        "description": "How pages are laid out.",
        "oneOf": [
          {
            "const": "continuous",
            "description": "One column of pages, scrolling continuously.",
            "type": "string"
          },
          {
            "const": "single",
            "description": "One page at a time.",
            "type": "string"
          },
          {
            "const": "two_page",
            "description": "Two pages side by side.",
            "type": "string"
          }
        ]
      },
      "ZoomSpec": {
        "description": "How far to zoom when going to a location.",
        "oneOf": [
          {
            "description": "Page width fills the view.",
            "properties": {
              "kind": {
                "const": "fit_width",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Whole page visible.",
            "properties": {
              "kind": {
                "const": "fit_page",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "A scale factor (1.0 = 100 %).",
            "properties": {
              "factor": {
                "description": "Factor.",
                "format": "float",
                "type": "number"
              },
              "kind": {
                "const": "scale",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "factor"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Where the reader was in a paper, and how it was shown.",
    "properties": {
      "bookmarks": {
        "default": [],
        "description": "Named places.",
        "items": {
          "$ref": "#/$defs/Bookmark"
        },
        "type": "array"
      },
      "location": {
        "anyOf": [
          {
            "$ref": "#/$defs/Location"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Last place."
      },
      "opened_ms": {
        "default": null,
        "description": "Last opened, ms since the Unix epoch (`None` if never opened).",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "paper": {
        "$ref": "#/$defs/PaperId",
        "description": "The paper."
      },
      "view_mode": {
        "$ref": "#/$defs/ViewMode",
        "default": "continuous",
        "description": "Layout."
      },
      "zoom": {
        "anyOf": [
          {
            "$ref": "#/$defs/ZoomSpec"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Zoom."
      }
    },
    "required": [
      "paper"
    ],
    "title": "ReadingState",
    "type": "object"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "read"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "Where the reader was in a paper, its zoom, layout and bookmarks"
}
