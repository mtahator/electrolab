{
  "command": "knowledge.digest_status",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "null",
    "type": "null"
  },
  "output": {
    "$defs": {
      "DigestWaiting": {
        "description": "Why making digests waits.",
        "oneOf": [
          {
            "const": "battery",
            "description": "The computer runs on its battery.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "State of making digests.",
    "properties": {
      "current": {
        "default": null,
        "description": "Title of the paper at work.",
        "type": [
          "string",
          "null"
        ]
      },
      "done": {
        "description": "Papers done.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "error": {
        "default": null,
        "description": "Why it ended early (an error kind, or a text).",
        "type": [
          "string",
          "null"
        ]
      },
      "full": {
        "description": "Written summaries are being made.",
        "type": "boolean"
      },
      "next": {
        "default": [],
        "description": "Papers waiting because they were asked for.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "paper": {
        "default": null,
        "description": "Id of the paper at work.",
        "type": [
          "string",
          "null"
        ]
      },
      "running": {
        "description": "Working.",
        "type": "boolean"
      },
      "step": {
        "default": null,
        "description": "Section at work (`12 / 30`).",
        "type": [
          "string",
          "null"
        ]
      },
      "stopped": {
        "default": false,
        "description": "The person stopped it.",
        "type": "boolean"
      },
      "total": {
        "description": "Papers.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "waiting": {
        "anyOf": [
          {
            "$ref": "#/$defs/DigestWaiting"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Why it waits."
      }
    },
    "required": [
      "running",
      "full",
      "done",
      "total"
    ],
    "title": "DigestStatus",
    "type": "object"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "read"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "State of making digests"
}
