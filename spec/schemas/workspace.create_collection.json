{
  "command": "workspace.create_collection",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input of `workspace.create_collection`.",
    "properties": {
      "name": {
        "description": "Name.",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "title": "CreateCollection",
    "type": "object"
  },
  "output": {
    "$defs": {
      "CollectionId": {
        "description": "A collection of papers.\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A named group of papers.",
    "properties": {
      "created_ms": {
        "description": "Created, ms since the Unix epoch.",
        "format": "int64",
        "type": "integer"
      },
      "id": {
        "$ref": "#/$defs/CollectionId",
        "description": "Id."
      },
      "name": {
        "description": "Name.",
        "type": "string"
      },
      "papers": {
        "description": "Number of papers in it.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "id",
      "name",
      "papers",
      "created_ms"
    ],
    "title": "Collection",
    "type": "object"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "create"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "Make a collection"
}
