{
  "command": "document.citation_markers",
  "input": {
    "$defs": {
      "BlobRef": {
        "description": "A file in the content-addressed store: messages carry these, never large bytes (§9.4).",
        "properties": {
          "hash": {
            "$ref": "#/$defs/Hash",
            "description": "Content hash."
          },
          "media_type": {
            "$ref": "#/$defs/MediaType",
            "description": "What the bytes are."
          },
          "size": {
            "description": "Size in bytes.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "size",
          "media_type"
        ],
        "type": "object"
      },
      "Hash": {
        "description": "BLAKE3 content hash (hex)",
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "MediaType": {
        "description": "A media type such as `application/pdf`.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input naming one page of a file.",
    "properties": {
      "file": {
        "$ref": "#/$defs/BlobRef",
        "description": "The file."
      },
      "page": {
        "description": "1-based page.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "file",
      "page"
    ],
    "title": "ObjectsRequest",
    "type": "object"
  },
  "output": {
    "$defs": {
      "CitationMarker": {
        "description": "An in-text citation marker (\"[12]\", \"[3–5, 9]\", \"(Smith et al., 2020)\").",
        "properties": {
          "entries": {
            "description": "Indexes into the reference list (0-based), in order.",
            "items": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "quads": {
            "description": "Where it is.",
            "items": {
              "$ref": "#/$defs/PageQuad"
            },
            "type": "array"
          },
          "text": {
            "description": "The text as printed.",
            "type": "string"
          }
        },
        "required": [
          "text",
          "quads",
          "entries"
        ],
        "type": "object"
      },
      "PagePoint": {
        "description": "A point on a page.",
        "properties": {
          "x": {
            "description": "Distance from the left edge.",
            "format": "float",
            "type": "number"
          },
          "y": {
            "description": "Distance from the top edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "PageQuad": {
        "description": "Four corners of text that may be rotated or skewed (upper-left, upper-right, lower-left,\nlower-right — the order PDF `/QuadPoints` use in practice).",
        "properties": {
          "p": {
            "description": "Corners.",
            "items": {
              "$ref": "#/$defs/PagePoint"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "p"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "$ref": "#/$defs/CitationMarker"
    },
    "title": "Array_of_CitationMarker",
    "type": "array"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "read"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "Citation markers on a page, linked to the reference list"
}
