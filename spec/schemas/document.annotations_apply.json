{
  "command": "document.annotations_apply",
  "input": {
    "$defs": {
      "Annotation": {
        "description": "One annotation.",
        "properties": {
          "author": {
            "default": null,
            "description": "Who made it.",
            "type": [
              "string",
              "null"
            ]
          },
          "body": {
            "default": "",
            "description": "The comment (note text, free text, or a comment on a mark).",
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/$defs/Category"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "What the mark means."
          },
          "color": {
            "description": "Colour as `#rrggbb`.",
            "type": "string"
          },
          "created_ms": {
            "description": "Created, ms since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "font_size": {
            "default": null,
            "description": "Free text: font size in points.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "id": {
            "description": "Stable id: `ep-…` for ours, the PDF's `/NM` (or `pdf-<object>-<generation>`) for imported\nones. Written to `/NM`, so re-importing updates instead of duplicating.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/AnnotationKind",
            "description": "What it is."
          },
          "line": {
            "default": null,
            "description": "Line and arrow: start and end.",
            "items": {
              "$ref": "#/$defs/PagePoint"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": [
              "array",
              "null"
            ]
          },
          "modified_ms": {
            "description": "Last changed, ms since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "opacity": {
            "default": 1.0,
            "description": "Opacity 0–1.",
            "format": "float",
            "type": "number"
          },
          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "parent": {
            "default": null,
            "description": "Replies: the note this answers.",
            "type": [
              "string",
              "null"
            ]
          },
          "paths": {
            "default": [],
            "description": "Ink: strokes, each a list of points.",
            "items": {
              "items": {
                "$ref": "#/$defs/PagePoint"
              },
              "type": "array"
            },
            "type": "array"
          },
          "pristine": {
            "default": false,
            "description": "Imported from the PDF and not changed since: saving keeps the file's own object.",
            "type": "boolean"
          },
          "quads": {
            "default": [],
            "description": "Text mark-up: one quad per line piece, from the engine's character boxes.",
            "items": {
              "$ref": "#/$defs/PageQuad"
            },
            "type": "array"
          },
          "rect": {
            "$ref": "#/$defs/PageRect",
            "description": "Bounds on the page. For notes, the icon; for free text and shapes, the box; for mark-up,\nink and lines, the area they cover (recomputed by the engine)."
          },
          "resolved": {
            "default": false,
            "description": "The thread is resolved (written as a `Review`/`Completed` state annotation).",
            "type": "boolean"
          },
          "text": {
            "default": null,
            "description": "Text mark-up: the marked text (for the sidebar, search and citations).",
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "default": 1.0,
            "description": "Stroke width in points (ink, shapes, lines, underline).",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "id",
          "page",
          "kind",
          "rect",
          "color",
          "created_ms",
          "modified_ms"
        ],
        "type": "object"
      },
      "AnnotationKind": {
        "description": "What an annotation is. Each maps to one standard PDF subtype (ADR-006).",
        "oneOf": [
          {
            "const": "highlight",
            "description": "Text mark-up: `/Highlight`.",
            "type": "string"
          },
          {
            "const": "underline",
            "description": "Text mark-up: `/Underline`.",
            "type": "string"
          },
          {
            "const": "strike_out",
            "description": "Text mark-up: `/StrikeOut`.",
            "type": "string"
          },
          {
            "const": "squiggly",
            "description": "Text mark-up: `/Squiggly`.",
            "type": "string"
          },
          {
            "const": "note",
            "description": "A note (sticky note) at a point: `/Text`. Replies are notes with a `parent`.",
            "type": "string"
          },
          {
            "const": "free_text",
            "description": "Text drawn on the page: `/FreeText`.",
            "type": "string"
          },
          {
            "const": "ink",
            "description": "Free-hand drawing: `/Ink`.",
            "type": "string"
          },
          {
            "const": "rectangle",
            "description": "`/Square`.",
            "type": "string"
          },
          {
            "const": "ellipse",
            "description": "`/Circle`.",
            "type": "string"
          },
          {
            "const": "line",
            "description": "`/Line`.",
            "type": "string"
          },
          {
            "const": "arrow",
            "description": "`/Line` with an arrowhead at the end.",
            "type": "string"
          }
        ]
      },
      "AnnotationOp": {
        "description": "One change in an edit.",
        "oneOf": [
          {
            "description": "Add a new annotation (its id must be new).",
            "properties": {
              "annotation": {
                "$ref": "#/$defs/Annotation",
                "description": "The annotation."
              },
              "op": {
                "const": "add",
                "type": "string"
              }
            },
            "required": [
              "op",
              "annotation"
            ],
            "type": "object"
          },
          {
            "description": "Replace an annotation with the same id.",
            "properties": {
              "annotation": {
                "$ref": "#/$defs/Annotation",
                "description": "The new version."
              },
              "op": {
                "const": "change",
                "type": "string"
              }
            },
            "required": [
              "op",
              "annotation"
            ],
            "type": "object"
          },
          {
            "description": "Remove an annotation and its replies.",
            "properties": {
              "id": {
                "description": "Its id.",
                "type": "string"
              },
              "op": {
                "const": "remove",
                "type": "string"
              }
            },
            "required": [
              "op",
              "id"
            ],
            "type": "object"
          }
        ]
      },
      "Category": {
        "description": "What a mark means to the reader (Draft 2.2 §28.3). Written to `/Subj`.",
        "oneOf": [
          {
            "const": "definition",
            "description": "A definition.",
            "type": "string"
          },
          {
            "const": "method",
            "description": "A method.",
            "type": "string"
          },
          {
            "const": "result",
            "description": "A result.",
            "type": "string"
          },
          {
            "const": "question",
            "description": "A question.",
            "type": "string"
          },
          {
            "const": "to_check",
            "description": "Something to check.",
            "type": "string"
          }
        ]
      },
      "PagePoint": {
        "description": "A point on a page.",
        "properties": {
          "x": {
            "description": "Distance from the left edge.",
            "format": "float",
            "type": "number"
          },
          "y": {
            "description": "Distance from the top edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "PageQuad": {
        "description": "Four corners of text that may be rotated or skewed (upper-left, upper-right, lower-left,\nlower-right — the order PDF `/QuadPoints` use in practice).",
        "properties": {
          "p": {
            "description": "Corners.",
            "items": {
              "$ref": "#/$defs/PagePoint"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "p"
        ],
        "type": "object"
      },
      "PageRect": {
        "description": "A rectangle on one page.",
