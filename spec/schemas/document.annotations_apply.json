          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "x0": {
            "description": "Left edge.",
            "format": "float",
            "type": "number"
          },
          "x1": {
            "description": "Right edge.",
            "format": "float",
            "type": "number"
          },
          "y0": {
            "description": "Top edge.",
            "format": "float",
            "type": "number"
          },
          "y1": {
            "description": "Bottom edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "page",
          "x0",
          "y0",
          "x1",
          "y1"
        ],
        "type": "object"
      },
      "PaperId": {
        "description": "A paper (a PDF in the library or a project).\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input of `document.annotations_apply`: changes applied together, undone together.",
    "properties": {
      "ops": {
        "description": "Changes, in order.",
        "items": {
          "$ref": "#/$defs/AnnotationOp"
        },
        "type": "array"
      },
      "paper": {
        "$ref": "#/$defs/PaperId",
        "description": "The paper."
      }
    },
    "required": [
      "paper",
      "ops"
    ],
    "title": "ApplyAnnotations",
    "type": "object"
