{
  "command": "workspace.remove_papers",
  "input": {
    "$defs": {
      "PaperId": {
        "description": "A paper (a PDF in the library or a project).\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input of `workspace.remove_papers` and `workspace.restore_papers`.",
    "properties": {
      "ids": {
        "description": "The papers.",
        "items": {
          "$ref": "#/$defs/PaperId"
        },
        "type": "array"
      }
    },
    "required": [
      "ids"
    ],
    "title": "PaperIds",
    "type": "object"
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "null",
    "type": "null"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "create"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "Take several papers out of the library (undo with restore_papers)"
}
