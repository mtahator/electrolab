{
  "command": "workspace.list_papers",
  "input": {
    "$defs": {
      "CollectionId": {
        "description": "A collection of papers.\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      },
      "PaperSort": {
        "description": "Order of `workspace.list_papers`.",
        "oneOf": [
          {
            "const": "added",
            "description": "Newest added first.",
            "type": "string"
          },
          {
            "const": "opened",
            "description": "Most recently opened first (never opened last).",
            "type": "string"
          },
          {
            "const": "title",
            "description": "By title (untitled by file name).",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input of `workspace.list_papers`.",
    "properties": {
      "collection": {
        "anyOf": [
          {
            "$ref": "#/$defs/CollectionId"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Only papers in this collection."
      },
      "limit": {
        "default": null,
        "description": "At most this many (default 200).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "offset": {
        "default": 0,
        "description": "Skip this many.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "query": {
        "default": null,
        "description": "Only papers whose title, authors, DOI or file name contain these words.",
        "type": [
          "string",
          "null"
        ]
      },
      "sort": {
        "$ref": "#/$defs/PaperSort",
        "default": "added",
        "description": "Order."
      },
      "tag": {
        "default": null,
        "description": "Only papers with this tag.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "ListPapers",
    "type": "object"
  },
  "output": {
    "$defs": {
      "BlobRef": {
        "description": "A file in the content-addressed store: messages carry these, never large bytes (§9.4).",
        "properties": {
          "hash": {
            "$ref": "#/$defs/Hash",
            "description": "Content hash."
          },
          "media_type": {
            "$ref": "#/$defs/MediaType",
            "description": "What the bytes are."
          },
          "size": {
            "description": "Size in bytes.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "size",
          "media_type"
        ],
        "type": "object"
      },
      "Hash": {
        "description": "BLAKE3 content hash (hex)",
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "MediaType": {
        "description": "A media type such as `application/pdf`.",
        "type": "string"
      },
      "Paper": {
        "description": "A paper in a library or project.",
        "properties": {
          "added_ms": {
            "description": "Added, ms since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "authors": {
            "default": [],
            "description": "Authors in order.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "doi": {
            "default": null,
            "description": "DOI (lowercase, without `https://doi.org/`).",
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "$ref": "#/$defs/BlobRef",
            "description": "The managed copy."
          },
          "id": {
            "$ref": "#/$defs/PaperId",
            "description": "Id."
          },
          "metadata_source": {
            "default": null,
            "description": "Where the metadata came from (e.g. `pdf-info`), when set.",
            "type": [
              "string",
              "null"
            ]
          },
          "opened_ms": {
            "default": null,
            "description": "Last opened, ms since the Unix epoch.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "original_name": {
            "description": "File name when added.",
            "type": "string"
          },
          "original_path": {
            "default": null,
            "description": "Where it came from on this machine, if added from a file.",
            "type": [
              "string",
              "null"
            ]
          },
          "pages": {
            "default": null,
            "description": "Number of pages, when known.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "source_url": {
            "default": null,
            "description": "The web address it was downloaded from, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "default": [],
            "description": "Tags.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "default": null,
            "description": "Title, when known.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "file",
          "original_name",
          "added_ms"
        ],
        "type": "object"
      },
      "PaperId": {
        "description": "A paper (a PDF in the library or a project).\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "$ref": "#/$defs/Paper"
    },
    "title": "Array_of_Paper",
    "type": "array"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "read"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "Papers: filter by collection, tag or words; sort by added, opened or title"
}
