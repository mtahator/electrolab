{
  "command": "workspace.undo_folders",
  "input": {
    "$defs": {
      "Collection": {
        "description": "A named group of papers.",
        "properties": {
          "created_ms": {
            "description": "Created, ms since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "$ref": "#/$defs/CollectionId",
            "description": "Id."
          },
          "name": {
            "description": "Name.",
            "type": "string"
          },
          "papers": {
            "description": "Number of papers in it.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/$defs/CollectionId"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The folder it is in; the top of the library when missing."
          }
        },
        "required": [
          "id",
          "name",
          "papers",
          "created_ms"
        ],
        "type": "object"
      },
      "CollectionId": {
        "description": "A collection of papers.\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      },
      "PaperId": {
        "description": "A paper (a PDF in the library or a project).\n\nSerialised as the UUID's canonical hyphenated string.",
        "format": "uuid",
        "type": "string"
      },
      "Placement": {
        "description": "The folders a paper was in.",
        "properties": {
          "collections": {
            "description": "Its folders.",
            "items": {
              "$ref": "#/$defs/CollectionId"
            },
            "type": "array"
          },
          "paper": {
            "$ref": "#/$defs/PaperId",
            "description": "Paper."
          }
        },
        "required": [
          "paper",
          "collections"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Output of `workspace.apply_folders`, and input of `workspace.undo_folders`.",
    "properties": {
      "before": {
        "description": "Where the papers were before.",
        "items": {
          "$ref": "#/$defs/Placement"
        },
        "type": "array"
      },
      "created": {
        "description": "Folders that were made.",
        "items": {
          "$ref": "#/$defs/Collection"
        },
        "type": "array"
      }
    },
    "required": [
      "created",
      "before"
    ],
    "title": "AppliedFolders",
    "type": "object"
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "null",
    "type": "null"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "create"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "Take apply_folders back"
}
