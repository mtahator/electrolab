{
  "command": "document.links",
  "input": {
    "$defs": {
      "BlobRef": {
        "description": "A file in the content-addressed store: messages carry these, never large bytes (§9.4).",
        "properties": {
          "hash": {
            "$ref": "#/$defs/Hash",
            "description": "Content hash."
          },
          "media_type": {
            "$ref": "#/$defs/MediaType",
            "description": "What the bytes are."
          },
          "size": {
            "description": "Size in bytes.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "size",
          "media_type"
        ],
        "type": "object"
      },
      "Hash": {
        "description": "BLAKE3 content hash (hex)",
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "MediaType": {
        "description": "A media type such as `application/pdf`.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input naming one page.",
    "properties": {
      "file": {
        "$ref": "#/$defs/BlobRef",
        "description": "The stored PDF."
      },
      "page": {
        "description": "1-based page number.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "file",
      "page"
    ],
    "title": "PageRequest",
    "type": "object"
  },
  "output": {
    "$defs": {
      "Link": {
        "description": "A link area on a page.",
        "properties": {
          "rect": {
            "$ref": "#/$defs/PageRect",
            "description": "The clickable area."
          },
          "target": {
            "$ref": "#/$defs/LinkTarget",
            "description": "Where it goes."
          }
        },
        "required": [
          "rect",
          "target"
        ],
        "type": "object"
      },
      "LinkTarget": {
        "description": "A place a link or bookmark points to.",
        "oneOf": [
          {
            "description": "A page in the same document; `top` is the y to show at the top of the view.",
            "properties": {
              "kind": {
                "const": "page",
                "type": "string"
              },
              "page": {
                "description": "1-based page.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "top": {
                "default": null,
                "description": "Page-space y, when the destination gives one.",
                "format": "float",
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "page"
            ],
            "type": "object"
          },
          {
            "description": "A web address (`http`, `https` or `mailto` only; others are reported as `unsupported`).",
            "properties": {
              "kind": {
                "const": "url",
                "type": "string"
              },
              "url": {
                "description": "The address.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "url"
            ],
            "type": "object"
          },
          {
            "description": "Anything else (launch actions, scripts, other files). Never followed.",
            "properties": {
              "kind": {
                "const": "unsupported",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "PageRect": {
        "description": "A rectangle on one page.",
        "properties": {
          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "x0": {
            "description": "Left edge.",
            "format": "float",
            "type": "number"
          },
          "x1": {
            "description": "Right edge.",
            "format": "float",
            "type": "number"
          },
          "y0": {
            "description": "Top edge.",
            "format": "float",
            "type": "number"
          },
          "y1": {
            "description": "Bottom edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "page",
          "x0",
          "y0",
          "x1",
          "y1"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "$ref": "#/$defs/Link"
    },
    "title": "Array_of_Link",
    "type": "array"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "read"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "Link areas of a page and where they go"
}
