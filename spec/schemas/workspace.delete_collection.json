    "required": [
      "id"
    ],
    "title": "CollectionRef",
    "type": "object"
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "null",
    "type": "null"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "destructive"
