{
  "command": "document.table",
  "input": {
    "$defs": {
      "BlobRef": {
        "description": "A file in the content-addressed store: messages carry these, never large bytes (§9.4).",
        "properties": {
          "hash": {
            "$ref": "#/$defs/Hash",
            "description": "Content hash."
          },
          "media_type": {
            "$ref": "#/$defs/MediaType",
            "description": "What the bytes are."
          },
          "size": {
            "description": "Size in bytes.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "size",
          "media_type"
        ],
        "type": "object"
      },
      "Hash": {
        "description": "BLAKE3 content hash (hex)",
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "MediaType": {
        "description": "A media type such as `application/pdf`.",
        "type": "string"
      },
      "ObjectRef": {
        "description": "A reference to an object in the same file.",
        "properties": {
          "id": {
            "description": "The object's id.",
            "type": "string"
          },
          "page": {
            "description": "1-based page.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "page",
          "id"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Input of `document.table`.",
    "properties": {
      "file": {
        "$ref": "#/$defs/BlobRef",
        "description": "The file."
      },
      "object": {
        "$ref": "#/$defs/ObjectRef",
        "description": "The table object."
      }
    },
    "required": [
      "file",
      "object"
    ],
    "title": "TableRequest",
    "type": "object"
  },
  "output": {
    "$defs": {
      "Cell": {
        "description": "One table cell.",
        "properties": {
          "rect": {
            "$ref": "#/$defs/PageRect",
            "description": "Box on the page."
          },
          "text": {
            "description": "Text.",
            "type": "string"
          },
          "value": {
            "default": null,
            "description": "The number in it, when the cell is numeric (\"1.2e-3\", \"45 %\", \"−0.7 ± 0.1\" → −0.7).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "rect"
        ],
        "type": "object"
      },
      "DocObject": {
        "description": "An object on a page.",
        "properties": {
          "caption_rect": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageRect"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The caption's box."
          },
          "id": {
            "description": "Stable within the file: `p<page>-<kind>-<n>`.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/ObjectKind",
            "description": "What it is."
          },
          "label": {
            "default": null,
            "description": "Printed label: \"Figure 3\", \"Table 2\", \"(7)\", \"4.2\".",
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "default": null,
            "description": "The number alone: \"3\", \"2\", \"7\", \"4.2\".",
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "description": "Position in reading order on the page (0 = first).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "rect": {
            "$ref": "#/$defs/PageRect",
            "description": "Where it is."
          },
          "score": {
            "description": "Detector confidence 0–1 (1 when found from the text alone).",
            "format": "float",
            "type": "number"
          },
          "text": {
            "default": null,
            "description": "Figures and tables: the caption text; headings: the heading text.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "rect",
          "score",
          "order"
        ],
        "type": "object"
      },
      "ObjectKind": {
        "description": "What an object on the page is.",
        "oneOf": [
          {
            "const": "figure",
            "description": "A figure, picture or chart.",
            "type": "string"
          },
          {
            "const": "table",
            "description": "A table.",
            "type": "string"
          },
          {
            "const": "equation",
            "description": "A displayed equation.",
            "type": "string"
          },
          {
            "const": "heading",
            "description": "A section heading.",
            "type": "string"
          },
          {
            "const": "title",
            "description": "The paper's title.",
            "type": "string"
          },
          {
            "const": "caption",
            "description": "A figure or table caption.",
            "type": "string"
          },
          {
            "const": "text",
            "description": "A paragraph of body text.",
            "type": "string"
          },
          {
            "const": "list_item",
            "description": "A list item.",
            "type": "string"
          },
          {
            "const": "footnote",
            "description": "A footnote.",
            "type": "string"
          },
          {
            "const": "page_furniture",
            "description": "Running header or footer.",
            "type": "string"
          },
          {
            "const": "code",
            "description": "Program code or an algorithm.",
            "type": "string"
          }
        ]
      },
      "PageRect": {
        "description": "A rectangle on one page.",
        "properties": {
          "page": {
            "description": "1-based page number.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "x0": {
            "description": "Left edge.",
            "format": "float",
            "type": "number"
          },
          "x1": {
            "description": "Right edge.",
            "format": "float",
            "type": "number"
          },
          "y0": {
            "description": "Top edge.",
            "format": "float",
            "type": "number"
          },
          "y1": {
            "description": "Bottom edge.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "page",
          "x0",
          "y0",
          "x1",
          "y1"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Output of `document.table`: cells in rows and columns, from the words inside the table box.",
    "properties": {
      "csv": {
        "description": "The table as CSV (RFC 4180).",
        "type": "string"
      },
      "header_rows": {
        "description": "How many leading rows are headers.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "object": {
        "$ref": "#/$defs/DocObject",
        "description": "The table object."
      },
      "page": {
        "description": "1-based page.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "rows": {
        "description": "Rows of cells (every row has the same number of columns).",
        "items": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "type": "array"
        },
        "type": "array"
      },
      "units": {
        "description": "Units found in header cells, per column (\"K\", \"W/m²\", \"%\"), when printed.",
        "items": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": "array"
      }
    },
    "required": [
      "object",
      "page",
      "rows",
      "header_rows",
      "units",
      "csv"
    ],
    "title": "Table",
    "type": "object"
  },
  "permission": {
    "data": [],
    "destination": "device",
    "operation": "read"
  },
  "stability": "experimental",
  "streaming": false,
  "summary": "A table as rows of cells, with CSV"
}
