{
  "name": "@electropaper/reader-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The Reader UI (library, viewer); hosted by hosts/reader (and later hosts/desktop)",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs.mjs",
    "predev": "node scripts/copy-pdfjs.mjs",
    "dev": "vite --port 1420 --strictPort",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electropaper/bindings": "workspace:*",
    "@electropaper/kit": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "pdfjs-dist": "6.4.299",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
