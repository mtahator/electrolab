{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElectroPaper Reader",
  "version": "0.1.0",
  "identifier": "app.electropaper.reader",
  "build": {
    "frontendDist": "../../../ui/reader/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @electropaper/reader-ui dev",
    "beforeBuildCommand": "pnpm --filter @electropaper/reader-ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ElectroPaper Reader",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: http://ep.localhost ep:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://ep.localhost ep:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../.natives/llama-cpp-vulkan/llama-server.exe": "llama-cpp-vulkan/llama-server.exe",
      "../../../.natives/llama-cpp-vulkan/*.dll": "llama-cpp-vulkan/",
      "../../../.natives/llama-cpp-vulkan/LICENSE*": "licenses/llama-cpp/",
      "licenses/llama.cpp-LICENSE.txt": "licenses/llama-cpp/llama.cpp-LICENSE.txt",
      "../../../.natives/pdfium/bin/pdfium.dll": "pdfium.dll",
      "../../../.natives/pdfium/LICENSE": "licenses/pdfium-LICENSE.txt",
      "../../../.natives/onnxruntime/onnxruntime-win-x64-1.31.1/lib/onnxruntime.dll": "onnxruntime.dll",
      "../../../.natives/onnxruntime/onnxruntime-win-x64-1.31.1/LICENSE": "licenses/onnxruntime-LICENSE.txt",
      "../../../.natives/models/ppocrv5-det/inference.onnx": "models/ppocrv5-det/inference.onnx",
      "../../../.natives/models/ppocrv5-rec-en/inference.onnx": "models/ppocrv5-rec-en/inference.onnx",
      "../../../.natives/models/ppocrv5-rec-en/inference.yml": "models/ppocrv5-rec-en/inference.yml"
    },
    "shortDescription": "Read, annotate and understand research papers",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ]
  }
}
