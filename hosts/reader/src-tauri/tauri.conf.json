{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElectroPaper Reader",
  "version": "0.1.0",
  "identifier": "app.electropaper.reader",
  "build": {
    "frontendDist": "../../../ui/reader/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @electropaper/reader-ui dev",
    "beforeBuildCommand": "pnpm --filter @electropaper/reader-ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ElectroPaper Reader",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://ep.localhost ep:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Read, annotate and understand research papers",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
